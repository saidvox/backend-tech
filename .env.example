POSTGRES_DB=techstore
POSTGRES_USER=techstore
POSTGRES_PASSWORD=techstore123
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/techstore
DB_USERNAME=techstore
DB_PASSWORD=techstore123
APP_DATASOURCE_AUTO_DETECT=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-admin-gmail@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_ENABLED=true
MAIL_FROM=TechStore Pro <your-admin-gmail@gmail.com>
MAIL_LOW_STOCK_ENABLED=true
# MAIL_LOW_STOCK_RECIPIENT=inventory-admin@gmail.com
# MAIL_LOW_STOCK_SUBJECT=Alerta de inventario - TechStore Pro
# MAIL_LOW_STOCK_CRON=0 0 8 * * *
# MAIL_LOW_STOCK_THRESHOLD=5
# MAIL_LOW_STOCK_INCLUDE_OUT_OF_STOCK=true

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:4200/auth/oauth2/success
OAUTH2_FAILURE_REDIRECT_URI=http://localhost:4200/login

MERCADO_PAGO_MODE=simulation
MERCADO_PAGO_API_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_SIMULATED_CHECKOUT_URL=http://localhost:4200/checkout/mercado-pago/simulacion
MERCADO_PAGO_NOTIFICATION_URL=http://localhost:8080/pagos/webhooks/mercado-pago
MERCADO_PAGO_SUCCESS_URL=http://localhost:4200/checkout/mercado-pago/retorno
MERCADO_PAGO_FAILURE_URL=http://localhost:4200/checkout/mercado-pago/retorno
MERCADO_PAGO_PENDING_URL=http://localhost:4200/checkout/mercado-pago/retorno
# Usa MERCADO_PAGO_MODE=simulation para demos locales sin cobros reales.
# Usa MERCADO_PAGO_MODE=sandbox solo cuando quieras probar el checkout externo de Mercado Pago.
# Para sandbox copia las credenciales desde "Credenciales de prueba".
# Mercado Pago puede mostrar estas credenciales con prefijo APP_USR- segun el pais/cuenta.
# MERCADO_PAGO_ACCESS_TOKEN=your-mercado-pago-test-access-token
# MERCADO_PAGO_PUBLIC_KEY=your-mercado-pago-test-public-key
# En sandbox puedes prellenar el comprador de prueba y exigir cuenta Mercado Pago.
# MERCADO_PAGO_TEST_PAYER_EMAIL=your-buyer-test-user
# MERCADO_PAGO_WALLET_PURCHASE_ONLY=true

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
# Opcion recomendada para Drive personal: OAuth del dueno de la carpeta.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token

# Opcion alternativa solo si usas Shared Drive o delegacion de dominio.
# Las service accounts no tienen cuota para subir a un Drive personal.
GOOGLE_DRIVE_CREDENTIALS_PATH=../your-service-account-key.json
# GOOGLE_DRIVE_CREDENTIALS_BASE64=base64-service-account-json
GOOGLE_DRIVE_MAX_IMAGE_SIZE_BYTES=5242880
